# REVORA Environment Configuration
# Copy this file to .env and populate with your Razorpay test credentials

# Razorpay Test Mode Credentials (from https://dashboard.razorpay.com/app/keys)
RAZORPAY_KEY_ID=your_razorpay_key_id_here
RAZORPAY_KEY_SECRET=your_razorpay_key_secret_here

# Optional: Razorpay Webhook Secret for HMAC-SHA256 signature verification
RAZORPAY_WEBHOOK_SECRET=your_webhook_secret_here

# Server Configuration
HOST=127.0.0.1
PORT=8000
